# GENSTRO INTELLIGENCE — npm Security Configuration
# OWASP 2026: Software Supply Chain Failures

# Always run audit on install
audit=true

# Pin to official npm registry
registry=https://registry.npmjs.org/

# Strict SSL verification
strict-ssl=true

# Warn on engine mismatches
engine-strict=true

# Save exact versions by default (reproducible builds)
save-exact=false

# Prevent lifecycle scripts from untrusted packages
ignore-scripts=false
