# ═══════════════════════════════════════════════════════════
# GENSTRO INTELLIGENCE — PCI-DSS 4.0 Level 1 Compliant Headers
# OWASP Top 10 2026 | PCI-DSS 4.0 Req 6.4.1–6.4.3, 11.6.1
# MITRE ATT&CK Mitigations | TLS 1.3 | Bootstrap 5.3.8 SRI
# ═══════════════════════════════════════════════════════════

/*
  # ─── OWASP A03: Content Security Policy (Injection/XSS Prevention) ───
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' blob:; media-src 'self'; object-src 'none'; child-src 'none'; frame-src 'none'; worker-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; upgrade-insecure-requests

  # ─── OWASP A01: Clickjacking Prevention ───
  X-Frame-Options: DENY

  # ─── OWASP A05: MIME Sniffing Prevention ───
  X-Content-Type-Options: nosniff

  # ─── OWASP A02 / MITRE T1557: TLS Enforcement (HSTS 2yr + preload) ───
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

  # ─── OWASP A03: XSS Filter ───
  X-XSS-Protection: 1; mode=block

  # ─── OWASP A01: Referrer Leakage Prevention ───
  Referrer-Policy: strict-origin-when-cross-origin

  # ─── OWASP A05: Feature/Permissions Restriction ───
  Permissions-Policy: accelerometer=(), ambient-light-sensor=(), autoplay=(), battery=(), camera=(), cross-origin-isolated=(), display-capture=(), document-domain=(), encrypted-media=(), execution-while-not-rendered=(), execution-while-out-of-viewport=(), fullscreen=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), magnetometer=(), microphone=(), midi=(), navigation-override=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), sync-xhr=(), usb=(), web-share=(), xr-spatial-tracking=()

  # ─── MITRE ATT&CK T1189: Cross-Origin Isolation ───
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

  # ─── OWASP A02: Certificate Transparency ───
  Expect-CT: max-age=86400, enforce

  # ─── MITRE ATT&CK T1592: Suppress Server Fingerprinting ───
  X-DNS-Prefetch-Control: off
  X-Permitted-Cross-Domain-Policies: none
  X-Download-Options: noopen
  X-Powered-By: !
  Server: !

  # ─── OWASP A08: Cache Control (prevent sensitive data caching) ───
  Cache-Control: no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

  # ─── Production: Allow Search Engine Indexing ───
  X-Robots-Tag: index, follow

/static/*
  # ─── PCI-DSS 4.0: Immutable Hashed Static Assets ───
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/img/*
  # ─── PCI-DSS 4.0: Image Caching with MIME Safety ───
  Cache-Control: public, max-age=86400, s-maxage=604800
  X-Content-Type-Options: nosniff

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400