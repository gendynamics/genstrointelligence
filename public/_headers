# ═══════════════════════════════════════════════════════════
# GENSTRO INTELLIGENCE — PCI-DSS 4.0 Level 1 Compliant Headers
# OWASP 2026 | PCI-DSS 4.0 Req 6.4.1–6.4.3, 11.6.1
# Maximum Security Posture
# ═══════════════════════════════════════════════════════════

/*
  # ─── PCI-DSS 4.0 Req 6.4.1: XSS & Injection Prevention ───
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; media-src 'self'; object-src 'none'; child-src 'none'; frame-src 'none'; worker-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; navigate-to 'self'; upgrade-insecure-requests

  # ─── PCI-DSS 4.0 Req 6.4.2: Clickjacking Prevention ───
  X-Frame-Options: DENY

  # ─── PCI-DSS 4.0 Req 6.4.3: MIME Sniffing Prevention ───
  X-Content-Type-Options: nosniff

  # ─── PCI-DSS 4.0 Req 4.2.1: TLS Enforcement (HSTS 2yr + preload) ───
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

  # ─── PCI-DSS 4.0 Req 6.2.4: XSS Filter ───
  X-XSS-Protection: 1; mode=block

  # ─── PCI-DSS 4.0 Req 6.4.1: Referrer Leakage Prevention ───
  Referrer-Policy: no-referrer

  # ─── PCI-DSS 4.0 Req 6.4.3: Feature Restriction ───
  Permissions-Policy: accelerometer=(), ambient-light-sensor=(), autoplay=(), battery=(), camera=(), cross-origin-isolated=(), display-capture=(), document-domain=(), encrypted-media=(), execution-while-not-rendered=(), execution-while-out-of-viewport=(), fullscreen=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), magnetometer=(), microphone=(), midi=(), navigation-override=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), sync-xhr=(), usb=(), web-share=(), xr-spatial-tracking=()

  # ─── PCI-DSS 4.0 Req 11.6.1: Cross-Origin Isolation ───
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

  # ─── PCI-DSS 4.0 Req 6.2.4: DNS & Download Hardening ───
  X-DNS-Prefetch-Control: off
  X-Permitted-Cross-Domain-Policies: none
  X-Download-Options: noopen

  # ─── PCI-DSS 4.0 Req 6.4.1: Cache Control (no sensitive data caching) ───
  Cache-Control: no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

  # ─── PCI-DSS 4.0 Req 6.2.2: Server Fingerprint Suppression ───
  X-Powered-By: !
  Server: !

  # ─── PCI-DSS 4.0 Req 6.4.1: Search Engine Exclusion ───
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex, notranslate

/static/*
  # ─── PCI-DSS 4.0: Immutable Hashed Static Assets ───
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/img/*
  # ─── PCI-DSS 4.0: Image Caching with MIME Safety ───
  Cache-Control: public, max-age=86400, s-maxage=604800
  X-Content-Type-Options: nosniff

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400